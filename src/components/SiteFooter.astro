---
import { luma, site } from '../config';
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <a class="wordmark" href="/">{site.name}</a>
      <p class="site-footer__colophon" style="margin-block-start: var(--space-2xs)">
        A monthly evening in Folkestone for people who make things. You are welcome at
        it.
      </p>
    </div>

    <div>
      <h2>The room</h2>
      <ul>
        <li><a href="/events">Upcoming events</a></li>
        <li><a href="/past">The archive</a></li>
        <li><a href="/about">About &amp; FAQ</a></li>
        <li><a href={luma.calendarUrl} rel="noopener">Follow the calendar on Luma</a></li>
      </ul>
    </div>

    <div>
      <h2>The small print</h2>
      <ul>
        <li><a href="/code-of-conduct">Code of conduct</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>
</footer>
